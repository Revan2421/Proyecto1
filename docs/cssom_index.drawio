        <mxCell id="n_header_css" value="CSSStyleDeclaration&lt;hr&gt;background-color: var(--main-color);&lt;br&gt;padding: 12px 24px;&lt;br&gt;display: flex;&lt;br&gt;align-items: center;&lt;br&gt;justify-content: space-between;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
